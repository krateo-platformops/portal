{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "region": {
      "type": "string",
      "title": "Region",
      "autocomplete": { "resourceRefId": "form-demo-regions", "closed": true }
    },
    "zone": {
      "type": "string",
      "title": "Zone",
      "description": "The zones of the region picked above.",
      "autocomplete": { "resourceRefId": "form-demo-zones", "closed": true },
      "dependsOn": { "name": "region", "extra": { "key": "region" } }
    },
    "targetNamespace": {
      "type": "string",
      "title": "Target namespace",
      "autocomplete": { "resourceRefId": "krateo-system/form-options-namespaces", "closed": true }
    },
    "service": {
      "type": "object",
      "title": "Service",
      "properties": {
        "type": { "type": "string", "title": "Service type", "enum": ["ClusterIP", "NodePort"], "default": "ClusterIP" },
        "nodePort": {
          "type": "integer",
          "title": "Node port",
          "minimum": 30000,
          "maximum": 32767,
          "displayDependency": { "dependsOn": { "name": "type" }, "conditionType": "value", "value": "NodePort" }
        }
      },
      "if": { "properties": { "type": { "const": "NodePort" } } },
      "then": { "required": ["nodePort"] }
    },
    "hosts": {
      "type": "array",
      "title": "Hosts",
      "minItems": 1,
      "maxItems": 5,
      "objectField": { "displayField": "host" },
      "items": {
        "type": "object",
        "required": ["host"],
        "properties": {
          "host": { "type": "string", "title": "Host", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "path": { "type": "string", "title": "Path", "default": "/" }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Image pull secrets",
      "items": { "type": "object" }
    }
  },
  "required": ["region", "zone", "hosts"]
}
